        display: grid;
        flex: 0 0 auto;
        width: 2rem;
        height: 2rem;
        place-items: center;
        box-sizing: border-box;
        border: 1px solid var(--border);
        border-radius: 0.45rem;
        color: var(--foreground-muted);
        font-family:
            "Cascadia Mono",
            "SFMono-Regular",
            Consolas,
            monospace;
        font-size: 0.7rem;
    }

    .section-title > div:last-child {
        min-width: 0;
    }

    .section-title h2 {
        margin: 0;
        color: var(--foreground);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
