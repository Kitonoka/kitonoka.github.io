        border-color: #7f1d1d;
        color: #fca5a5;
    }

    .token-input {
        display: block;
        width: 100%;
        min-height: 180px;
        box-sizing: border-box;
        resize: vertical;
        padding: 1.25rem;
        border: 0;
        outline: 0;
        background: var(--background);
        color: var(--foreground);
        font-family:
            "Cascadia Mono",
            "SFMono-Regular",
            Consolas,
            "Liberation Mono",
            monospace;
        font-size: 0.82rem;
        line-height: 1.7;
    }

    .token-input::selection {
        background: var(--accent);
        color: white;
    }

    .token-input::placeholder {
        color: var(--foreground-muted);
        opacity: 0.5;
    }

    .input-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 42px;
        padding: 0 0.9rem;
        border-top: 1px solid var(--border);
        color: var(--foreground-muted);
        font-size: 0.7rem;
    }

    #token-status.invalid {
        color: #ef4444;
    }

    .error {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        width: 100%;
        box-sizing: border-box;
        padding: 0.8rem 1rem;
        border: 1px solid #7f1d1d;
        border-radius: 0.55rem;
        background: var(--background-secondary);
        color: #fca5a5;
        font-size: 0.8rem;
    }

    .error-icon,
    .warning-icon {
        display: grid;
        flex: 0 0 auto;
        width: 1.35rem;
        height: 1.35rem;
        place-items: center;
        border-radius: 50%;
        font-size: 0.7rem;
        font-weight: 700;
    }

    .error-icon {
        border: 1px solid currentColor;
    }

