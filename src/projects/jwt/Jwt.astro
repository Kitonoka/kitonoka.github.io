---
const exampleToken =
    "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiYWRtaW4iOnRydWUsImlhdCI6MTUxNjIzOTAyMn0.KMUFsIDTnFmyG3nMiGM6H9FNFUROf3wh7SmqJp-QV30";
---

<main class="jwt-tool">
    <header class="header">
        <div class="heading">
            <a class="back" href="/">← Kitonoka</a>

            <p class="eyebrow">Project</p>

            <h1>JWT Decoder</h1>

            <p class="description">
                Decode JSON Web Tokens locally and inspect their header,
                payload, signature, and common claims.
            </p>
        </div>
    </header>

    <section class="workspace" aria-label="JWT decoder">
        <section class="panel token-panel">
            <div class="panel-header">
                <div>
                    <span>JWT Token</span>
                    <span class="panel-description">
                        Paste a JSON Web Token to inspect its contents.
                    </span>
                </div>

                <button
                    class="button"
                    id="example-button"
                    type="button"
                >
                    Example
                </button>
            </div>

            <textarea
                id="token-input"
                class="token-input"
                spellcheck="false"
                autocomplete="off"
                autocapitalize="off"
                placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
            ></textarea>

            <div class="input-footer">
                <span id="token-status">
                    Waiting for token
                </span>

                <button
                    class="button button-danger"
                    id="clear-button"
                    type="button"
                >
                    Clear
                </button>
            </div>
        </section>

        <div
            id="error"
            class="error"
            hidden
        >
            <span class="error-icon">!</span>
            <span id="error-message"></span>
        </div>

        <div id="results" hidden>
            <div class="sections">
                <section class="panel">
                    <div class="section-header">
                        <div class="section-title">
                            <span class="section-label">01</span>

                            <div>
                                <h2>Header</h2>
                                <p>Decoded JWT header</p>
                            </div>
                        </div>

                        <button
                            class="button copy-button"
                            type="button"
                            data-copy-target="header-json"
                        >
                            Copy
                        </button>
                    </div>

                    <div class="code-container">
                        <pre id="header-json"></pre>
                    </div>
                </section>

                <section class="panel">
                    <div class="section-header">
                        <div class="section-title">
                            <span class="section-label">02</span>

                            <div>
                                <h2>Payload</h2>
                                <p>Decoded JWT claims</p>
                            </div>
                        </div>

                        <button
                            class="button copy-button"
                            type="button"
                            data-copy-target="payload-json"
                        >
                            Copy
                        </button>
                    </div>

                    <div class="code-container">
                        <pre id="payload-json"></pre>
                    </div>
                </section>

                <section class="panel">
                    <div class="section-header">
                        <div class="section-title">
                            <span class="section-label">03</span>

                            <div>
                                <h2>Signature</h2>
                                <p>Raw signature segment</p>
                            </div>
                        </div>

                        <button
                            class="button copy-button"
                            type="button"
                            data-copy-target="signature"
                        >
                            Copy
                        </button>
                    </div>

                    <div class="signature-container">
                        <code id="signature"></code>
                    </div>

                    <div class="signature-warning">
                        <span class="warning-icon">!</span>

                        <div>
                            <strong>
                                Signature not verified
                            </strong>

                            <p>
                                Decoding a JWT does not prove that it is
                                authentic or trustworthy. This tool only
                                parses the token and does not verify its
                                signature.
                            </p>
                        </div>
                    </div>
                </section>
            </div>

            <section class="panel token-info-panel">
                <div class="section-header">
                    <div class="section-title">
                        <span class="section-label">04</span>

                        <div>
                            <h2>Token information</h2>
                            <p>
                                Common JWT claims and metadata
                            </p>
                        </div>
                    </div>
                </div>

                <div class="info-code-container">
                    <pre id="token-info"></pre>
                </div>
            </section>
        </div>
    </section>
</main>

<script define:vars={{ exampleToken }}>
    const tokenInput =
        document.querySelector("#token-input");

    const error =
        document.querySelector("#error");

    const errorMessage =
        document.querySelector("#error-message");

    const results =
        document.querySelector("#results");

    const tokenStatus =
        document.querySelector("#token-status");

    const headerJson =
        document.querySelector("#header-json");

    const payloadJson =
        document.querySelector("#payload-json");

    const signature =
        document.querySelector("#signature");

    const tokenInfo =
        document.querySelector("#token-info");

    const exampleButton =
        document.querySelector("#example-button");

    const clearButton =
        document.querySelector("#clear-button");

    function decodeBase64Url(value) {
        const normalized =
            value
                .replaceAll("-", "+")
                .replaceAll("_", "/");

        const padding =
            "=".repeat(
                (4 - (normalized.length % 4)) % 4,
            );

        const binary =
            atob(normalized + padding);

        const bytes =
            Uint8Array.from(
                binary,
                (character) =>
                    character.charCodeAt(0),
            );

        return new TextDecoder(
            "utf-8",
            { fatal: true },
        ).decode(bytes);
    }

    function decodeJsonSegment(segment) {
        return JSON.parse(
            decodeBase64Url(segment),
        );
    }

    function formatValue(value) {
        if (Array.isArray(value)) {
            return value
                .map((item) => formatValue(item))
                .join(", ");
        }

        if (
            value !== null &&
            typeof value === "object"
        ) {
            return JSON.stringify(value);
        }

        return String(value);
    }

    function relativeTime(seconds) {
        const delta =
            seconds -
            Math.floor(
                Date.now() / 1000,
            );

        const absolute =
            Math.abs(delta);

        let value;
        let unit;

        if (absolute < 60) {
            value = Math.floor(absolute);
            unit = "second";
        } else if (absolute < 3600) {
            value = Math.floor(
                absolute / 60,
            );
            unit = "minute";
        } else if (absolute < 86400) {
            value = Math.floor(
                absolute / 3600,
            );
            unit = "hour";
        } else {
            value = Math.floor(
                absolute / 86400,
            );
            unit = "day";
        }

        value = Math.max(value, 1);

        const suffix =
            value === 1 ? "" : "s";

        return delta >= 0
            ? `in ${value} ${unit}${suffix}`
            : `${value} ${unit}${suffix} ago`;
    }

    function addInfo(
        label,
        value,
        state = "",
    ) {
        const line =
            document.createElement("div");

        line.className =
            state
                ? `info-line ${state}`
                : "info-line";

        const labelElement =
            document.createElement("span");

        labelElement.className =
            "info-key";

        labelElement.textContent =
            label;

        const separator =
            document.createElement("span");

        separator.className =
            "info-separator";

        separator.textContent =
            ":";

        const valueElement =
            document.createElement("span");

        valueElement.className =
            "info-value";

        valueElement.textContent =
            value;

        line.append(
            labelElement,
            separator,
            valueElement,
        );

        tokenInfo.appendChild(line);
    }

    function renderTokenInfo(
        header,
        payload,
    ) {
        tokenInfo.replaceChildren();

        if (
            header.alg !== undefined
        ) {
            addInfo(
                "Algorithm",
                formatValue(header.alg),
            );
        }

        if (
            header.typ !== undefined
        ) {
            addInfo(
                "Type",
                formatValue(header.typ),
            );
        }

        if (
            typeof payload.iat === "number"
        ) {
            addInfo(
                "Issued",
                relativeTime(payload.iat),
            );
        }

        if (
            typeof payload.nbf === "number"
        ) {
            const now =
                Math.floor(
                    Date.now() / 1000,
                );

            addInfo(
                "Not before",
                payload.nbf > now
                    ? relativeTime(payload.nbf)
                    : "Active",
                payload.nbf > now
                    ? ""
                    : "active",
            );
        }

        if (
            typeof payload.exp === "number"
        ) {
            const now =
                Math.floor(
                    Date.now() / 1000,
                );

            const expired =
                payload.exp < now;

            addInfo(
                "Expiration",
                expired
                    ? `Expired ${relativeTime(payload.exp)}`
                    : `Expires ${relativeTime(payload.exp)}`,
                expired
                    ? "expired"
                    : "active",
            );
        }

        if (
            !tokenInfo.children.length
        ) {
            const empty =
                document.createElement("span");

            empty.className =
                "no-info";

            empty.textContent =
                "No standard claims found.";

            tokenInfo.appendChild(empty);
        }
    }

    function parseToken(token) {
        const parts =
            token
                .trim()
                .split(".");

        if (parts.length !== 3) {
            throw new Error(
                "A JWT must contain exactly three dot-separated segments.",
            );
        }

        if (
            parts.some(
                (part) => !part,
            )
        ) {
            throw new Error(
                "The JWT contains an empty segment.",
            );
        }

        let header;
        let payload;

        try {
            header =
                decodeJsonSegment(
                    parts[0],
                );
        } catch {
            throw new Error(
                "The JWT header is not valid Base64URL JSON.",
            );
        }

        try {
            payload =
                decodeJsonSegment(
                    parts[1],
                );
        } catch {
            throw new Error(
                "The JWT payload is not valid Base64URL JSON.",
            );
        }

        if (
            !header ||
            typeof header !== "object" ||
            Array.isArray(header)
        ) {
            throw new Error(
                "The JWT header must contain a JSON object.",
            );
        }

        if (
            !payload ||
            typeof payload !== "object" ||
            Array.isArray(payload)
        ) {
            throw new Error(
                "The JWT payload must contain a JSON object.",
            );
        }

        return {
            header,
            payload,
            signature: parts[2],
        };
    }

    function showError(message) {
        error.hidden = false;

        errorMessage.textContent =
            message;

        results.hidden = true;

        tokenStatus.textContent =
            "Invalid token";

        tokenStatus.classList.add(
            "invalid",
        );
    }

    function update() {
        const token =
            tokenInput.value.trim();

        if (!token) {
            error.hidden = true;
            results.hidden = true;

            tokenStatus.textContent =
                "Waiting for token";

            tokenStatus.classList.remove(
                "invalid",
            );

            return;
        }

        try {
            const {
                header,
                payload,
                signature: rawSignature,
            } = parseToken(token);

            error.hidden = true;

            tokenStatus.classList.remove(
                "invalid",
            );

            tokenStatus.textContent =
                "Valid JWT structure";

            headerJson.textContent =
                JSON.stringify(
                    header,
                    null,
                    2,
                );

            payloadJson.textContent =
                JSON.stringify(
                    payload,
                    null,
                    2,
                );

            signature.textContent =
                rawSignature;

            renderTokenInfo(
                header,
                payload,
            );

            results.hidden = false;
        } catch (exception) {
            showError(
                exception instanceof Error
                    ? exception.message
                    : "Unable to decode token.",
            );
        }
    }

    async function copyText(
        value,
        button,
    ) {
        try {
            await navigator.clipboard.writeText(
                value,
            );

            const original =
                button.textContent;

            button.textContent =
                "Copied";

            setTimeout(() => {
                button.textContent =
                    original;
            }, 1200);
        } catch {
            button.textContent =
                "Failed";

            setTimeout(() => {
                button.textContent =
                    "Copy";
            }, 1200);
        }
    }

    tokenInput.addEventListener(
        "input",
        update,
    );

    exampleButton.addEventListener(
        "click",
        () => {
            tokenInput.value =
                exampleToken;

            update();
        },
    );

    clearButton.addEventListener(
        "click",
        () => {
            tokenInput.value = "";

            update();

            tokenInput.focus();
        },
    );

    document
        .querySelectorAll(".copy-button")
        .forEach((button) => {
            button.addEventListener(
                "click",
                () => {
                    const targetId =
                        button.getAttribute(
                            "data-copy-target",
                        );

                    const target =
                        targetId
                            ? document.getElementById(
                                  targetId,
                              )
                            : null;

                    if (target) {
                        copyText(
                            target.textContent ?? "",
                            button,
                        );
                    }
                },
            );
        });
</script>

<style>
    .jwt-tool {
        width: min(1400px, calc(100% - 2rem));
        min-height: 100vh;
        margin: 0 auto;
        padding: 4rem 0;
    }

    .header {
        margin-bottom: 2rem;
    }

    .heading {
        min-width: 0;
    }

    .back {
