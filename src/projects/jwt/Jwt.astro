        color: var(--foreground-muted);
        font-size: 0.72rem;
        font-weight: 400;
        letter-spacing: normal;
        text-transform: none;
    }

    .code-container {
        width: 100%;
        max-height: 25rem;
        box-sizing: border-box;
        overflow: auto;
        background: var(--background);
    }

    .jwt-tool pre {
        display: block;
        width: 100%;
        box-sizing: border-box;
        margin: 0;
        padding: 1.25rem;
        color: var(--foreground);
        font-family:
            "Cascadia Mono",
            "SFMono-Regular",
            Consolas,
            "Liberation Mono",
            monospace;
        font-size: 0.78rem;
        line-height: 1.7;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .signature-container {
        width: 100%;
        box-sizing: border-box;
        padding: 1.25rem;
        background: var(--background);
    }

    .signature-container code {
        display: block;
        max-width: 100%;
        color: var(--foreground);
        font-family:
            "Cascadia Mono",
            "SFMono-Regular",
            Consolas,
            "Liberation Mono",
            monospace;
        font-size: 0.78rem;
        line-height: 1.7;
        overflow-wrap: anywhere;
        word-break: break-all;
    }

    .signature-warning {
        display: flex;
        gap: 0.75rem;
        width: 100%;
        box-sizing: border-box;
        padding: 0.9rem 1rem;
        border-top: 1px solid var(--border);
    }

    .warning-icon {
        border: 1px solid #f59e0b;
        color: #f59e0b;
    }

    .signature-warning > div {
        min-width: 0;
    }

    .signature-warning strong {
        color: var(--foreground);
        font-size: 0.78rem;
        font-weight: 600;
    }

    .signature-warning p {
        margin: 0.25rem 0 0;
        color: var(--foreground-muted);
        font-size: 0.72rem;
        line-height: 1.5;
    }

    .info-code-container {
        width: 100%;
        box-sizing: border-box;
        padding: 1.25rem;
        overflow-x: auto;
        background: var(--background);
    }

    .info-code-container pre {
        margin: 0;
        padding: 0;
        color: var(--foreground);
        font-family:
            "Cascadia Mono",
            "SFMono-Regular",
            Consolas,
            "Liberation Mono",
            monospace;
        font-size: 0.78rem;
        line-height: 1.7;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .info-line {
        display: flex;
        align-items: baseline;
        min-width: max-content;
    }

    .info-key {
        color: var(--accent);
        font-weight: 600;
    }

    .info-separator {
        margin: 0 0.7rem 0 0.1rem;
        color: var(--foreground-muted);
    }

    .info-value {
        color: var(--foreground);
        font-weight: 600;
    }

    .info-line.expired .info-value {
        color: #ef4444;
    }

    .info-line.active .info-value {
        color: #22c55e;
    }

    .no-info {
        color: var(--foreground-muted);
    }

    @media (max-width: 600px) {
        .jwt-tool {
            width: min(100% - 1.5rem, 1400px);
            padding: 2.5rem 0;
        }

        .back {
