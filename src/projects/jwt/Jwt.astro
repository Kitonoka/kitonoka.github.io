        font-size: 0.85rem;
        transition: color 160ms ease;
    }

    .back:hover {
        color: var(--foreground);
    }

    .eyebrow {
        margin: 0 0 0.75rem;
        color: var(--accent);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

