        width: 100%;
        min-width: 0;
        box-sizing: border-box;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 0.8rem;
        background: var(--background-secondary);
    }

    .panel-header,
    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 42px;
        padding: 0 0.9rem;
        box-sizing: border-box;
        border-bottom: 1px solid var(--border);
        color: var(--foreground-muted);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .panel-header > div {
        min-width: 0;
    }

    .panel-description {
        display: block;
        margin-top: 0.2rem;
        color: var(--foreground-muted);
        font-size: 0.72rem;
        font-weight: 400;
        letter-spacing: normal;
        text-transform: none;
    }

