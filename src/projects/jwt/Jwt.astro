        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .section-header {
        min-height: 64px;
        padding: 0.8rem 0.9rem;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        min-width: 0;
    }

