    :global(.diff-line) {
        display: grid;
        grid-template-columns:
            3.5rem
            3.5rem
            2rem
            minmax(0, 1fr);

        min-width: 650px;
        min-height: 1.65em;

        background: #09090b !important;
    }

    :global(.diff-line code) {
        min-width: 0;
        padding: 0 1rem 0 0.25rem;
        color: #a1a1aa !important;
        white-space: pre;
        background: transparent !important;
    }

    :global(.diff-line .line-number) {
        padding: 0 0.65rem;
        border-right: 1px solid #27272a !important;
        color: #52525b !important;
        text-align: right;
        user-select: none;
    }

    :global(.diff-line .line-marker) {
        color: #52525b !important;
        font-weight: 700;
        text-align: center;
        user-select: none;
    }

    :global(.diff-line.same) {
        background: #09090b !important;
    }

    :global(.diff-line.same:hover) {
        background: #18181b !important;
    }

    /*
