<main class="diff-viewer">
    <header class="header">
        <div class="heading">
            <a class="back" href="/">← Kitonoka</a>

            <p class="eyebrow">Project</p>

            <h1>Diff Viewer</h1>

            <p class="description">
                Upload two files and compare their contents with a
                GitHub-style line-by-line diff.
            </p>
        </div>

        <div class="actions">
            <button id="clear" type="button">
                Clear
            </button>
        </div>
    </header>

    <section class="upload-grid" aria-label="Files">
        <label class="file-card" for="file-a">
            <span class="file-card-header">
                <span>Original</span>

                <span id="file-a-name" class="file-name">
                    No file selected
                </span>
            </span>

            <span class="drop-area" id="drop-a">
                <span class="drop-icon">↑</span>

                <strong id="drop-a-title">
                    Choose original file
                </strong>

                <span id="drop-a-subtitle">
                    or drag and drop it here
                </span>
            </span>

            <input
                id="file-a"
                type="file"
                aria-label="Choose original file"
            />
        </label>

        <label class="file-card" for="file-b">
            <span class="file-card-header">
                <span>Modified</span>

                <span id="file-b-name" class="file-name">
                    No file selected
                </span>
            </span>

            <span class="drop-area" id="drop-b">
                <span class="drop-icon">↑</span>

                <strong id="drop-b-title">
                    Choose modified file
                </strong>

                <span id="drop-b-subtitle">
                    or drag and drop it here
                </span>
            </span>

            <input
                id="file-b"
                type="file"
                aria-label="Choose modified file"
            />
        </label>
    </section>

    <section class="stats" aria-live="polite">
        <div class="stat removed-stat">
            <span id="removed-count">0</span>
            <span>removed</span>
        </div>

        <div class="stat added-stat">
            <span id="added-count">0</span>
            <span>added</span>
        </div>

        <div class="stat">
            <span id="unchanged-count">0</span>
            <span>unchanged</span>
        </div>

        <div class="stat">
            <span id="total-count">0</span>
            <span>lines</span>
        </div>
    </section>

    <section class="diff-container" aria-label="Diff">
        <div class="diff-header">
            <div class="diff-heading">
                <span class="diff-title">Changes</span>

                <span id="diff-subtitle" class="diff-subtitle">
                    Select two files to compare
                </span>
            </div>

            <span id="diff-status" class="status">
                Waiting
            </span>
        </div>

        <div id="diff" class="diff">
            <div class="empty">
                <span class="empty-icon">±</span>

                <strong>No comparison yet</strong>

                <span>
                    Select two files to automatically compare them.
                </span>
            </div>
        </div>
    </section>
</main>

<script>
    type DiffType =
        | "same"
        | "added"
        | "removed";

    type DiffLine = {
        type: DiffType;
        oldLine: number | null;
        newLine: number | null;
        content: string;
    };

    const fileA =
        document.querySelector("#file-a");

    const fileB =
        document.querySelector("#file-b");

    const fileAName =
        document.querySelector("#file-a-name");

    const fileBName =
        document.querySelector("#file-b-name");

    const dropA =
        document.querySelector("#drop-a");

    const dropB =
        document.querySelector("#drop-b");

    const dropATitle =
        document.querySelector("#drop-a-title");

    const dropASubtitle =
        document.querySelector("#drop-a-subtitle");

    const dropBTitle =
        document.querySelector("#drop-b-title");

    const dropBSubtitle =
        document.querySelector("#drop-b-subtitle");

    const clearButton =
        document.querySelector("#clear");

    const diff =
        document.querySelector("#diff");

    const diffSubtitle =
        document.querySelector("#diff-subtitle");

    const diffStatus =
        document.querySelector("#diff-status");

    const removedCount =
        document.querySelector("#removed-count");

    const addedCount =
        document.querySelector("#added-count");

    const unchangedCount =
        document.querySelector("#unchanged-count");

    const totalCount =
        document.querySelector("#total-count");

    if (
        !(fileA instanceof HTMLInputElement) ||
        !(fileB instanceof HTMLInputElement) ||
        !(fileAName instanceof HTMLElement) ||
        !(fileBName instanceof HTMLElement) ||
        !(dropA instanceof HTMLElement) ||
        !(dropB instanceof HTMLElement) ||
        !(dropATitle instanceof HTMLElement) ||
        !(dropASubtitle instanceof HTMLElement) ||
        !(dropBTitle instanceof HTMLElement) ||
        !(dropBSubtitle instanceof HTMLElement) ||
        !(clearButton instanceof HTMLButtonElement) ||
        !(diff instanceof HTMLElement) ||
        !(diffSubtitle instanceof HTMLElement) ||
        !(diffStatus instanceof HTMLElement) ||
        !(removedCount instanceof HTMLElement) ||
        !(addedCount instanceof HTMLElement) ||
        !(unchangedCount instanceof HTMLElement) ||
        !(totalCount instanceof HTMLElement)
    ) {
        throw new Error(
            "Diff Viewer failed to initialize."
        );
    }

    let originalFile: File | null = null;
    let modifiedFile: File | null = null;

    const escapeHtml = (
        value: string
    ) => {
        return value
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    };

    const getLines = (
        content: string
    ) => {
        return content
            .replace(/\r\n/g, "\n")
            .replace(/\r/g, "\n")
            .split("\n");
    };

    const createDiff = (
        oldLines: string[],
        newLines: string[]
    ): DiffLine[] => {
        const rows =
            oldLines.length + 1;

        const columns =
            newLines.length + 1;

        const matrix: number[][] =
            Array.from(
                { length: rows },
                () =>
                    new Array(columns).fill(0)
            );

        for (
            let oldIndex =
                oldLines.length - 1;
            oldIndex >= 0;
            oldIndex--
        ) {
            for (
                let newIndex =
                    newLines.length - 1;
                newIndex >= 0;
                newIndex--
            ) {
                if (
                    oldLines[oldIndex] ===
                    newLines[newIndex]
                ) {
                    matrix[oldIndex][newIndex] =
                        matrix[
                            oldIndex + 1
                        ][
                            newIndex + 1
                        ] + 1;
                } else {
                    matrix[oldIndex][newIndex] =
                        Math.max(
                            matrix[
                                oldIndex + 1
                            ][newIndex],
                            matrix[
                                oldIndex
                            ][newIndex + 1]
                        );
                }
            }
        }

        const result: DiffLine[] = [];

        let oldIndex = 0;
        let newIndex = 0;

        let oldLine = 1;
        let newLine = 1;

        while (
            oldIndex < oldLines.length &&
            newIndex < newLines.length
        ) {
            if (
                oldLines[oldIndex] ===
                newLines[newIndex]
            ) {
                result.push({
                    type: "same",
                    oldLine,
                    newLine,
                    content:
                        oldLines[oldIndex],
                });

                oldIndex++;
                newIndex++;
                oldLine++;
                newLine++;

                continue;
            }

            if (
                matrix[
                    oldIndex + 1
                ][newIndex] >=
                matrix[oldIndex][
                    newIndex + 1
                ]
            ) {
                result.push({
                    type: "removed",
                    oldLine,
                    newLine: null,
                    content:
                        oldLines[oldIndex],
                });

                oldIndex++;
                oldLine++;
            } else {
                result.push({
                    type: "added",
                    oldLine: null,
                    newLine,
                    content:
                        newLines[newIndex],
                });

                newIndex++;
                newLine++;
            }
        }

        while (
            oldIndex <
            oldLines.length
        ) {
            result.push({
                type: "removed",
                oldLine,
                newLine: null,
                content:
                    oldLines[oldIndex],
            });

            oldIndex++;
            oldLine++;
        }

        while (
            newIndex <
            newLines.length
        ) {
            result.push({
                type: "added",
                oldLine: null,
                newLine,
                content:
                    newLines[newIndex],
            });

            newIndex++;
            newLine++;
        }

        return result;
    };

    const renderDiff = (
        lines: DiffLine[],
        oldName: string,
        newName: string
    ) => {
        diff.innerHTML = lines
            .map((line) => {
                const marker =
                    line.type === "added"
                        ? "+"
                        : line.type === "removed"
                          ? "-"
                          : "";

                const oldNumber =
                    line.oldLine === null
                        ? ""
                        : String(
                              line.oldLine
                          );

                const newNumber =
                    line.newLine === null
                        ? ""
                        : String(
                              line.newLine
                          );

                return `
                    <div class="diff-line ${line.type}">
                        <span class="line-number">
                            ${oldNumber}
                        </span>

                        <span class="line-number">
                            ${newNumber}
                        </span>

                        <span class="line-marker">
                            ${marker}
                        </span>

                        <code>${escapeHtml(
                            line.content
                        ) || " "}</code>
                    </div>
                `;
            })
            .join("");

        const removed =
            lines.filter(
                (line) =>
                    line.type ===
                    "removed"
            ).length;

        const added =
            lines.filter(
                (line) =>
                    line.type ===
                    "added"
            ).length;

        const unchanged =
            lines.filter(
                (line) =>
                    line.type ===
                    "same"
            ).length;

        removedCount.textContent =
            String(removed);

        addedCount.textContent =
            String(added);

        unchangedCount.textContent =
            String(unchanged);

        totalCount.textContent =
            String(lines.length);

        diffSubtitle.textContent =
            `${oldName} → ${newName}`;

        if (
            removed === 0 &&
            added === 0
        ) {
            diffStatus.textContent =
                "No changes";

            diffStatus.classList.add(
                "clean"
            );
        } else {
            diffStatus.textContent =
                `${added + removed} changes`;

            diffStatus.classList.remove(
                "clean"
            );
        }
    };

    const compareFiles = async () => {
        if (
            !originalFile ||
            !modifiedFile
        ) {
            return;
        }

        diffStatus.textContent =
            "Comparing";

        diffStatus.classList.remove(
            "clean"
        );

        const oldContent =
            await originalFile.text();

        const newContent =
            await modifiedFile.text();

        const oldLines =
            getLines(oldContent);

        const newLines =
            getLines(newContent);

        const lines =
            createDiff(
                oldLines,
                newLines
            );

        renderDiff(
            lines,
            originalFile.name,
            modifiedFile.name
        );
    };

    const updateDropZone = (
        target: "a" | "b",
        file: File
    ) => {
        const size =
            file.size < 1024
                ? `${file.size} B`
                : `${(
                      file.size /
                      1024
                  ).toFixed(1)} KB`;

        if (target === "a") {
            fileAName.textContent =
                file.name;

            dropATitle.textContent =
                "File loaded";

            dropASubtitle.textContent =
                `${size} · click to replace`;

            dropA.classList.add(
                "loaded"
            );
        } else {
            fileBName.textContent =
                file.name;

            dropBTitle.textContent =
                "File loaded";

            dropBSubtitle.textContent =
                `${size} · click to replace`;

            dropB.classList.add(
                "loaded"
            );
        }
    };

    const setFile = (
        file: File,
        target: "a" | "b"
    ) => {
        if (target === "a") {
            originalFile = file;
        } else {
            modifiedFile = file;
        }

        updateDropZone(
            target,
            file
        );

        if (
            originalFile &&
            modifiedFile
        ) {
            compareFiles();
        }
    };

    const setupDropZone = (
        zone: HTMLElement,
        target: "a" | "b"
    ) => {
        zone.addEventListener(
            "dragover",
            (event) => {
                event.preventDefault();

                zone.classList.add(
                    "dragging"
                );
            }
        );

        zone.addEventListener(
            "dragleave",
            () => {
                zone.classList.remove(
                    "dragging"
                );
            }
        );

        zone.addEventListener(
            "drop",
            (event) => {
                event.preventDefault();

                zone.classList.remove(
                    "dragging"
                );

                const file =
                    event.dataTransfer
                        ?.files?.[0];

                if (file) {
                    setFile(
                        file,
                        target
                    );
                }
            }
        );
    };

    fileA.addEventListener(
        "change",
        () => {
            const file =
                fileA.files?.[0];

            if (file) {
                setFile(
                    file,
                    "a"
                );
            }
        }
    );

    fileB.addEventListener(
        "change",
        () => {
            const file =
                fileB.files?.[0];

            if (file) {
                setFile(
                    file,
                    "b"
                );
            }
        }
    );

    clearButton.addEventListener(
        "click",
        () => {
            originalFile = null;
            modifiedFile = null;

            fileA.value = "";
            fileB.value = "";

            fileAName.textContent =
                "No file selected";

            fileBName.textContent =
                "No file selected";

            dropATitle.textContent =
                "Choose original file";

            dropASubtitle.textContent =
                "or drag and drop it here";

            dropBTitle.textContent =
                "Choose modified file";

            dropBSubtitle.textContent =
                "or drag and drop it here";

            dropA.classList.remove(
                "loaded"
            );

            dropB.classList.remove(
                "loaded"
            );

            diffSubtitle.textContent =
                "Select two files to compare";

            diffStatus.textContent =
                "Waiting";

            diffStatus.classList.remove(
                "clean"
            );

            removedCount.textContent =
                "0";

            addedCount.textContent =
                "0";

            unchangedCount.textContent =
                "0";

            totalCount.textContent =
                "0";

            diff.innerHTML = `
                <div class="empty">
                    <span class="empty-icon">±</span>

                    <strong>
                        No comparison yet
                    </strong>

                    <span>
                        Select two files to
                        automatically compare them.
                    </span>
                </div>
            `;
        }
    );

    setupDropZone(
        dropA,
        "a"
    );

    setupDropZone(
        dropB,
        "b"
    );
</script>

