---
const defaultSvg = `<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 400 300"
>
  <rect
    width="400"
    height="300"
    rx="24"
    fill="#09090b"
  />

  <circle
    cx="200"
    cy="125"
    r="64"
    fill="#8b5cf6"
  />

  <path
    d="M165 125l24 24 48-52"
    fill="none"
    stroke="#ffffff"
    stroke-width="14"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>`;
---

<main class="svg-create">
    <header class="header">
        <div class="heading">
            <a class="back" href="/">← Kitonoka</a>

            <p class="eyebrow">Project</p>

            <h1>SVG Create</h1>

            <p class="description">
                Write SVG directly and see the result instantly.
            </p>
        </div>

        <div class="actions">
            <button id="reset" type="button">
                Reset
            </button>

            <button id="copy" type="button">
                Copy SVG
            </button>

            <button
                id="download"
                class="primary"
                type="button"
            >
                Download
            </button>
        </div>
    </header>

    <section class="workspace" aria-label="SVG editor">
        <div class="panel editor-panel">
            <div class="panel-header">
                <span>SVG</span>
                <span id="status" class="status">Ready</span>
            </div>

            <textarea
                id="editor"
                spellcheck="false"
                autocapitalize="off"
                autocomplete="off"
                autocorrect="off"
                aria-label="SVG source"
            >{defaultSvg}</textarea>
        </div>

        <div class="panel preview-panel">
            <div class="panel-header">
                <span>Preview</span>

                <span id="dimensions" class="dimensions">
                    400 × 300
                </span>
            </div>

            <div class="preview">
                <div
                    id="preview-container"
                    class="preview-container"
                ></div>

                <div
                    id="error"
                    class="error"
                    hidden
                ></div>
            </div>
        </div>
    </section>
</main>

<script define:vars={{ defaultSvg }}>
    const editor = document.querySelector("#editor");
    const previewContainer =
        document.querySelector("#preview-container");
    const error = document.querySelector("#error");
    const status = document.querySelector("#status");
    const dimensions =
        document.querySelector("#dimensions");

    const resetButton =
        document.querySelector("#reset");
    const copyButton =
        document.querySelector("#copy");
    const downloadButton =
        document.querySelector("#download");

    if (
        !(editor instanceof HTMLTextAreaElement) ||
        !(previewContainer instanceof HTMLElement) ||
        !(error instanceof HTMLElement) ||
        !(status instanceof HTMLElement) ||
        !(dimensions instanceof HTMLElement) ||
        !(resetButton instanceof HTMLButtonElement) ||
        !(copyButton instanceof HTMLButtonElement) ||
        !(downloadButton instanceof HTMLButtonElement)
    ) {
        throw new Error(
            "SVG Create failed to initialize."
        );
    }

    const updateStatus = (value) => {
        status.textContent = value;
    };

    const updateDimensions = (svg) => {
        const viewBox = svg.getAttribute("viewBox");

        if (viewBox) {
            const values = viewBox
                .trim()
                .split(/[\s,]+/)
                .map(Number);

            if (
                values.length === 4 &&
                values.every(Number.isFinite)
            ) {
                dimensions.textContent =
                    `${values[2]} × ${values[3]}`;

                return;
            }
        }

        const width = svg.getAttribute("width");
        const height = svg.getAttribute("height");

        if (width && height) {
            dimensions.textContent =
                `${width} × ${height}`;
            return;
        }

        dimensions.textContent = "Unknown size";
    };

    const sanitizeSvg = (svg) => {
        svg
            .querySelectorAll(
                "script, iframe, object, embed, foreignObject"
            )
            .forEach((element) => element.remove());

        svg.querySelectorAll("*").forEach((element) => {
            [...element.attributes].forEach((attribute) => {
                const name =
                    attribute.name.toLowerCase();
                const value =
                    attribute.value.trim().toLowerCase();

                if (name.startsWith("on")) {
                    element.removeAttribute(
                        attribute.name
                    );
                    return;
                }

                if (
                    (name === "href" ||
                        name === "xlink:href") &&
                    (
                        value.startsWith(
                            "javascript:"
                        ) ||
                        value.startsWith(
                            "data:text/html"
                        )
                    )
                ) {
                    element.removeAttribute(
                        attribute.name
                    );
                }
            });
        });
    };

    const render = () => {
        const source = editor.value.trim();

        if (!source) {
            previewContainer.replaceChildren();
            error.hidden = true;
            updateStatus("Empty");
            dimensions.textContent = "No SVG";
            return;
        }

        const parser = new DOMParser();

        const document = parser.parseFromString(
            source,
            "image/svg+xml"
        );

        const parserError =
            document.querySelector("parsererror");

        if (parserError) {
            previewContainer.replaceChildren();

            error.textContent =
                "Invalid SVG markup.";

            error.hidden = false;

            updateStatus("Invalid");
            dimensions.textContent = "Invalid";

            return;
        }

        const svg = document.documentElement;

        if (
            svg.tagName.toLowerCase() !== "svg"
        ) {
            previewContainer.replaceChildren();

            error.textContent =
                "The root element must be <svg>.";

            error.hidden = false;

            updateStatus("Invalid");
            dimensions.textContent = "Invalid";

            return;
        }

        sanitizeSvg(svg);
        updateDimensions(svg);

        const renderedSvg =
            document.importNode(svg, true);

        previewContainer.replaceChildren(
            renderedSvg
        );

        error.hidden = true;
        updateStatus("Valid");
    };

    const flashButton = (
        button,
        message,
        duration = 1400
    ) => {
        const original = button.textContent;

        button.textContent = message;

        window.setTimeout(() => {
            button.textContent = original;
        }, duration);
    };

    editor.addEventListener(
        "input",
        render
    );

    resetButton.addEventListener(
        "click",
        () => {
            editor.value = defaultSvg;
            render();
        }
    );

    copyButton.addEventListener(
        "click",
        async () => {
            try {
                await navigator.clipboard.writeText(
                    editor.value
                );

                flashButton(
                    copyButton,
                    "Copied"
                );
            } catch {
                flashButton(
                    copyButton,
                    "Failed"
                );
            }
        }
    );

    downloadButton.addEventListener(
        "click",
        () => {
            const blob = new Blob(
                [editor.value],
                {
                    type:
                        "image/svg+xml;charset=utf-8",
                }
            );

            const url =
                URL.createObjectURL(blob);

            const anchor =
                document.createElement("a");

            anchor.href = url;
            anchor.download = "kitonoka.svg";

            document.body.appendChild(anchor);
            anchor.click();
            anchor.remove();

            URL.revokeObjectURL(url);
        }
    );

    render();
</script>

<style>
    .svg-create {
        width: min(1400px, calc(100% - 2rem));
        min-height: 100vh;
        margin: 0 auto;
        padding: 4rem 0;
    }

    .header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 2rem;
        margin-bottom: 2rem;
    }

    .heading {
        min-width: 0;
    }

    .back {
        display: inline-block;
        margin-bottom: 2.5rem;
        color: var(--foreground-muted);
        font-size: 0.85rem;
        transition: color 160ms ease;
    }

    .back:hover {
        color: var(--foreground);
    }

    .eyebrow {
        margin: 0 0 0.75rem;
        color: var(--accent);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    h1 {
        margin: 0;
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 800;
        letter-spacing: -0.06em;
        line-height: 0.95;
    }

    .description {
        max-width: 520px;
        margin: 1rem 0 0;
        color: var(--foreground-muted);
        line-height: 1.6;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.5rem;
    }

    .actions button {
        padding: 0.65rem 0.9rem;
        border: 1px solid var(--border);
        border-radius: 0.55rem;
        background: var(--background-secondary);
        color: var(--foreground);
        cursor: pointer;
        font-size: 0.85rem;
        transition:
            border-color 160ms ease,
            transform 160ms ease,
            background 160ms ease;
    }

    .actions button:hover {
        border-color: var(--accent);
        transform: translateY(-1px);
    }

    .actions button.primary {
        border-color: var(--accent);
        background: var(--accent);
        color: white;
    }

    .workspace {
        display: grid;
        grid-template-columns:
            minmax(0, 1fr)
            minmax(0, 1fr);
        min-height: 650px;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 0.8rem;
        background: var(--background-secondary);
    }

    .panel {
        min-width: 0;
    }

    .editor-panel {
        display: flex;
        flex-direction: column;
        border-right: 1px solid var(--border);
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 42px;
        padding: 0 0.9rem;
        border-bottom: 1px solid var(--border);
        color: var(--foreground-muted);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .status {
        color: var(--accent);
    }

    .dimensions {
        color: var(--foreground-muted);
        font-weight: 500;
        letter-spacing: normal;
        text-transform: none;
    }

    textarea {
        width: 100%;
        min-height: 608px;
        flex: 1;
        resize: none;
        padding: 1.25rem;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--foreground);
        font-family:
            "Cascadia Mono",
            "SFMono-Regular",
            Consolas,
            "Liberation Mono",
            monospace;
        font-size: 0.82rem;
        line-height: 1.7;
        tab-size: 2;
    }

    textarea::selection {
        background: var(--accent);
        color: white;
    }

    .preview {
        position: relative;
        display: flex;
        flex: 1;
        align-items: center;
        justify-content: center;
        min-height: 608px;
        padding: 2rem;
        overflow: hidden;

        background:
            linear-gradient(
                45deg,
                var(--background) 25%,
                transparent 25%
            ) 0 0 / 24px 24px,
            linear-gradient(
                -45deg,
                var(--background) 25%,
                transparent 25%
            ) 0 12px / 24px 24px,
            linear-gradient(
                45deg,
                transparent 75%,
                var(--background) 75%
            ) 12px -12px / 24px 24px,
            linear-gradient(
                -45deg,
                transparent 75%,
                var(--background) 75%
            ) -12px 0 / 24px 24px,
            var(--background-secondary);
    }

    .preview-container {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
    }

    .preview-container svg {
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: 100%;
        border-radius: 0.35rem;
    }

    .error {
        position: absolute;
        right: 1rem;
        bottom: 1rem;
        left: 1rem;
        padding: 0.8rem 1rem;
        border: 1px solid #7f1d1d;
        border-radius: 0.55rem;
        background: var(--background-secondary);
        color: #fca5a5;
        font-size: 0.8rem;
    }

    @media (max-width: 900px) {
        .header {
            align-items: flex-start;
            flex-direction: column;
        }

        .actions {
            justify-content: flex-start;
        }

        .workspace {
            grid-template-columns: 1fr;
        }

        .editor-panel {
            min-height: 500px;
            border-right: 0;
            border-bottom: 1px solid var(--border);
        }

        textarea {
            min-height: 500px;
        }

        .preview {
            min-height: 500px;
        }
    }

    @media (max-width: 600px) {
        .svg-create {
            width: min(100% - 1.5rem, 1400px);
            padding: 2.5rem 0;
        }

        .back {
            margin-bottom: 2rem;
        }

        .actions {
            width: 100%;
        }

        .actions button {
            flex: 1;
        }

        .workspace {
            min-height: 0;
        }
    }
</style>