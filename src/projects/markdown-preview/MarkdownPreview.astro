---
const defaultMarkdown = `# Kitonoka

This is a **Markdown** editor with live preview.

## Features

- Write in **Markdown** format
- See *real-time* preview
- Export to **HTML**, **MDX**, or raw Markdown
- Syntax highlighting for inline code
- Tables
- Links
- Blockquotes
- Ordered and unordered lists
- Inline \`code\` formatting

## Table Example

| Platform | Value | Example |
| --- | --- | --- |
| Linux | \`$XDG_CONFIG_HOME\` or \`$HOME/.config\` | \`/home/alice/.config\` |
| macOS | \`$HOME/Library/Application Support\` | \`/Users/Alice/Library/Application Support\` |
| Windows | \`{FOLDERID_RoamingAppData}\` | \`C:\\Users\\Alice\\AppData\\Roaming\` |

> **Note:** config_dir table by dirs rust crate.

## JavaScript Example

\`\`\`javascript
async function fetchData() {
    const response = await fetch('/api/data');

    if (!response.ok) {
        throw new Error('Failed to fetch data');
    }

    return response.json();
}
\`\`\`

## Rust Example

\`\`\`rust
use std::fs;

fn main() {
    let config = fs::read_to_string("config.toml")
        .expect("Failed to read config.toml");

    println!("{config}");
}
\`\`\`

## More Markdown

You can combine **bold text**, *italic text*, and \`inline code\` in the same paragraph.

You can also create [links](https://kitonoka.github.io/) to other websites.

### Ordered List

1. Open the configuration directory
2. Find \`config.toml\`
3. Edit the configuration
4. Restart the application

### Unordered List

- Configuration
- Environment variables
- File paths
- Platform-specific settings

---

**Start writing your Markdown here.**
`;
---

<main class="markdown-preview">
    <header class="header">
        <div class="heading">
            <a class="back" href="/">← Kitonoka</a>

            <p class="eyebrow">Project</p>

            <h1>Markdown Preview</h1>

            <p class="description">
                Write Markdown and see the rendered result instantly.
            </p>
        </div>

        <div class="actions">
            <button id="clear" type="button">
                Clear
            </button>

            <button id="reset" type="button">
                Reset
            </button>

            <button id="copy" type="button">
                Copy HTML
            </button>

            <button id="download-md" type="button">
                Download MD
            </button>
        </div>
    </header>

    <section class="workspace" aria-label="Markdown editor">
        <div class="panel editor-panel">
            <div class="panel-header">
                <span>Markdown</span>

                <span id="char-count" class="meta">
                    0 chars
                </span>
            </div>

            <textarea
                id="editor"
                spellcheck="false"
                autocapitalize="off"
                autocomplete="off"
                autocorrect="off"
                aria-label="Markdown source"
            >{defaultMarkdown}</textarea>
        </div>

        <div class="panel preview-panel">
            <div class="panel-header">
                <span>Preview</span>

                <span id="word-count" class="meta">
                    0 words
                </span>
            </div>

            <div
                id="preview"
                class="preview"
            ></div>
        </div>
    </section>
</main>

<script>
    import { marked } from "marked";
    import hljs from "highlight.js/lib/common";

    const editor =
        document.querySelector("#editor");

    const preview =
        document.querySelector("#preview");

    const charCount =
        document.querySelector("#char-count");

    const wordCount =
        document.querySelector("#word-count");

    const clearButton =
        document.querySelector("#clear");

    const resetButton =
        document.querySelector("#reset");

    const copyButton =
        document.querySelector("#copy");

    const downloadButton =
        document.querySelector("#download-md");

    if (
        !(editor instanceof HTMLTextAreaElement) ||
        !(preview instanceof HTMLElement) ||
        !(charCount instanceof HTMLElement) ||
        !(wordCount instanceof HTMLElement) ||
        !(clearButton instanceof HTMLButtonElement) ||
        !(resetButton instanceof HTMLButtonElement) ||
        !(copyButton instanceof HTMLButtonElement) ||
        !(downloadButton instanceof HTMLButtonElement)
    ) {
        throw new Error(
            "Markdown Preview failed to initialize."
        );
    }

    const defaultMarkdown =
        editor.defaultValue;

    marked.setOptions({
        gfm: true,
        breaks: true,
    });

    const highlightCode = () => {
        preview
            .querySelectorAll("pre code")
            .forEach((element) => {
                if (!(element instanceof HTMLElement)) {
                    return;
                }

                const languageClass =
                    [...element.classList].find(
                        (value) =>
                            value.startsWith(
                                "language-"
                            )
                    );

                if (!languageClass) {
                    return;
                }

                const language =
                    languageClass
                        .slice("language-".length)
                        .toLowerCase();

                if (
                    language === "text" ||
                    language === "plaintext" ||
                    language === "plain"
                ) {
                    return;
                }

                if (!hljs.getLanguage(language)) {
                    return;
                }

                const source =
                    element.textContent ?? "";

                try {
                    const result =
                        hljs.highlight(
                            source,
                            {
                                language,
                                ignoreIllegals: true,
                            }
                        );

                    element.innerHTML =
                        result.value;

                    element.classList.add("hljs");
                } catch {
                    // Leave the original code untouched.
                }
            });
    };

    const updateStats = (markdown) => {
        charCount.textContent =
            `${markdown.length} chars`;

        const trimmed =
            markdown.trim();

        const words = trimmed
            ? trimmed
                  .replace(
                      /[`*_#>|[\](){}]/g,
                      " "
                  )
                  .split(/\s+/)
                  .filter(Boolean)
                  .length
            : 0;

        wordCount.textContent =
            `${words} words`;
    };

    const render = () => {
        const markdown =
            editor.value;

        preview.innerHTML =
            marked.parse(markdown);

        highlightCode();
        updateStats(markdown);
    };

    const flashButton = (
        button,
        message,
        duration = 1400
    ) => {
        const original =
            button.textContent;

        button.textContent =
            message;

        window.setTimeout(() => {
            button.textContent =
                original;
        }, duration);
    };

    const downloadFile = (
        filename,
        content,
        type
    ) => {
        const blob =
            new Blob(
                [content],
                { type }
            );

        const url =
            URL.createObjectURL(blob);

        const anchor =
            document.createElement("a");

        anchor.href = url;
        anchor.download = filename;

        document.body.appendChild(anchor);
        anchor.click();
        anchor.remove();

        URL.revokeObjectURL(url);
    };

    editor.addEventListener(
        "input",
        render
    );

    clearButton.addEventListener(
        "click",
        () => {
            editor.value = "";

            render();

            editor.focus();
        }
    );

    resetButton.addEventListener(
        "click",
        () => {
            editor.value =
                defaultMarkdown;

            render();

            editor.focus();
        }
    );

    copyButton.addEventListener(
        "click",
        async () => {
            try {
                const html =
                    marked.parse(
                        editor.value
                    );

                await navigator.clipboard.writeText(
                    html
                );

                flashButton(
                    copyButton,
                    "Copied"
                );
            } catch {
                flashButton(
                    copyButton,
                    "Failed"
                );
            }
        }
    );

    downloadButton.addEventListener(
        "click",
        () => {
            downloadFile(
                "markdown.md",
                editor.value,
                "text/markdown;charset=utf-8"
            );
        }
    );

    render();
</script>

