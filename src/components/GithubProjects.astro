---
import { getGitHubRepositories } from "../lib/github";

const repositories = await getGitHubRepositories();
const projects = repositories.slice(0, 6);
---

<section class="projects-section">
    <div class="section-header">
        <div>
            <p class="section-eyebrow">GitHub</p>
            <h2>Projects</h2>
        </div>

        <a
            class="github-link"
            href="https://github.com/Kitonoka"
            target="_blank"
            rel="noopener noreferrer"
        >
            View GitHub
            <span aria-hidden="true">↗</span>
        </a>
    </div>

    {projects.length > 0 ? (
        <div class="projects-grid">
            {projects.map((project) => (
                <a
                    class="project-card"
                    href={project.html_url}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <div class="project-card-top">
                        <div class="project-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path
                                    fill="currentColor"
                                    d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.04c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.74.08-.74 1.2.09 1.84 1.23 1.84 1.23 1.07 1.84 2.8 1.31 3.49 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.6-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .5Z"
                                />
                            </svg>
                        </div>

                        <span class="project-arrow" aria-hidden="true">
                            ↗
                        </span>
                    </div>

                    <h3>{project.name}</h3>

                    <p>
                        {project.description ?? "No description provided."}
                    </p>

                    <div class="project-meta">
                        {project.language && (
                            <span class="language">
                                <span class="language-dot"></span>
                                {project.language}
                            </span>
                        )}

                        {project.stargazers_count > 0 && (
                            <span>★ {project.stargazers_count}</span>
                        )}

                        {project.forks_count > 0 && (
                            <span>{project.forks_count} forks</span>
                        )}
                    </div>
                </a>
            ))}
        </div>
    ) : (
        <div class="empty-state">
            <p>No public projects found.</p>
        </div>
    )}
</section>

<style>
    .projects-section {
        margin-top: 7rem;
    }

    .section-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 2rem;
        margin-bottom: 2rem;
    }

    .section-eyebrow {
        margin: 0 0 0.5rem;
        color: var(--accent);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    h2 {
        margin: 0;
        font-size: clamp(2rem, 5vw, 3rem);
        letter-spacing: -0.04em;
    }

    .github-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--foreground-muted);
        font-size: 0.9rem;
        transition:
            color 160ms ease,
            transform 160ms ease;
    }

    .github-link:hover {
        color: var(--foreground);
        transform: translateX(2px);
    }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    .project-card {
        display: flex;
        min-height: 220px;
        flex-direction: column;
        padding: 1.5rem;
        border: 1px solid var(--border);
        border-radius: 1rem;
        background: var(--background-secondary);
        transition:
            border-color 180ms ease,
            transform 180ms ease,
            background 180ms ease;
    }

    .project-card:hover {
        border-color: color-mix(
            in srgb,
            var(--accent) 45%,
            var(--border)
        );
        background: color-mix(
            in srgb,
            var(--background-secondary) 92%,
            var(--accent)
        );
        transform: translateY(-3px);
    }

    .project-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

    .project-icon {
        display: grid;
        width: 2.5rem;
        height: 2.5rem;
        place-items: center;
        border: 1px solid var(--border);
        border-radius: 0.7rem;
        color: var(--foreground-muted);
    }

    .project-icon svg {
        width: 1.25rem;
        height: 1.25rem;
    }

    .project-arrow {
        color: var(--foreground-muted);
        font-size: 1.2rem;
        transition:
            color 180ms ease,
            transform 180ms ease;
    }

    .project-card:hover .project-arrow {
        color: var(--accent);
        transform: translate(2px, -2px);
    }

    h3 {
        margin: 0 0 0.65rem;
        font-size: 1.15rem;
        letter-spacing: -0.02em;
    }

    .project-card p {
        display: -webkit-box;
        margin: 0;
        overflow: hidden;
        color: var(--foreground-muted);
        font-size: 0.9rem;
        line-height: 1.6;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
    }

    .project-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem;
        margin-top: auto;
        padding-top: 1.5rem;
        color: var(--foreground-muted);
        font-size: 0.75rem;
    }

    .language {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .language-dot {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 999px;
        background: var(--accent);
    }

    .empty-state {
        padding: 3rem;
        border: 1px solid var(--border);
        border-radius: 1rem;
        color: var(--foreground-muted);
        text-align: center;
    }

    @media (max-width: 700px) {
        .projects-section {
            margin-top: 5rem;
        }

        .section-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 1rem;
        }

        .projects-grid {
            grid-template-columns: 1fr;
        }
    }
</style>